      "traits": [
        {
          "desc": "The compsognathus has advantage on Dexterity (Stealth) checks made to hide in tall grass.",
          "desc_ru": "Особенность «Грассландс Камоуфлаге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob2_swarm-of-compsognathus_grasslands-camouflage",
          "name": "Grasslands Camouflage",
          "name_ru": "Грассландс Камоуфлаге",
          "parent": "tob2_swarm-of-compsognathus",
          "ru_source": "derived"
        },
        {
          "desc": "The swarm can occupy another creature’s space and vice versa, and the swarm can move through any opening large enough for a Tiny compsognathus. The swarm can’t regain hp or gain temporary hp.",
