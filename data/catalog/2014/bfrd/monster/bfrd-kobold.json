    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee or Ranged Weapon Attack:_ +4 to hit, reach 5 ft. or range 20/60 ft., one target. _Hit:_ 4 (1d4+2) piercing damage.",
          "desc_ru": "Атака оружием ближнего или дальнего боя: +4 к попаданию, досягаемость 5 фт. или дистанция 20/60 фт., одна цель. Попадание: 4 (1к4+2) колющего урона.",
          "external_id": "bfrd_kobold_dagger",
          "name": "Dagger",
          "name_ru": "Кинжал",
          "order_in_statblock": 0,
          "parent": "bfrd_kobold",
          "ru_source": "template"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The kobold moves up to 15 feet without provoking opportunity attacks. If the kobold is aware of traps in the area, the kobold can choose if this movement triggers any of them.",
          "desc_ru": "Действие «Скуррй»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_kobold_scurry",
          "name": "Scurry",
          "name_ru": "Скуррй",
          "order_in_statblock": 0,
          "parent": "bfrd_kobold",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Ranged Weapon Attack:_ +4 to hit, range 30/120 ft., one target. _Hit:_ 4 (1d4+2) bludgeoning damage.",
          "desc_ru": "Атака оружием дальнего боя: +4 к попаданию, дистанция 30/120 фт., одна цель. Попадание: 4 (1к4+2) дробящего урона.",
          "external_id": "bfrd_kobold_sling",
          "name": "Sling",
          "name_ru": "Праща",
          "order_in_statblock": 1,
          "parent": "bfrd_kobold",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "The kobold has advantage on attack rolls against a creature if at least one of the kobold's allies is within 5 feet of the creature and the ally isn't incapacitated.",
          "desc_ru": "Совершает броски атаки по существу с преимуществом, если хотя бы один его союзник находится в пределах 5 футов от существа и этот союзник не выведен из строя.",
          "external_id": "bfrd_kobold_pack-tactics",
          "name": "Pack Tactics",
          "name_ru": "Пак Тактикс",
          "parent": "bfrd_kobold",
          "ru_source": "template"
        },
        {
          "desc": "While in sunlight, the kobold has disadvantage on attack rolls, and its Perception is 3 when perceiving by sight.",
          "desc_ru": "Особенность «Сунлигхт Сенситивитй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_kobold_sunlight-sensitivity",
          "name": "Sunlight Sensitivity",
          "name_ru": "Сунлигхт Сенситивитй",
          "parent": "bfrd_kobold",
          "ru_source": "derived"
        }
      ]
    },
