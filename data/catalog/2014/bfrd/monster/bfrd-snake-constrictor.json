          "order_in_statblock": 0,
          "parent": "bfrd_snake-constrictor",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one creature. _Hit:_ 6 (1d8+2) bludgeoning damage, and the target is grappled (escape DC 12), if it is a Large or smaller creature. Until this grapple ends, the creature is restrained, and the snake can't Constrict another target.",
          "desc_ru": "Действие «Констрикт»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-constrictor_constrict",
          "name": "Constrict",
          "name_ru": "Констрикт",
          "order_in_statblock": 1,
          "parent": "bfrd_snake-constrictor",
          "ru_source": "derived"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "One creature grappled by the snake must succeed on a DC 12 STR or take 4 (1d8) bludgeoning damage and begin suffocating. The creature continues suffocating until the grapple ends.",
          "desc_ru": "Действие «Круш»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-constrictor_crush",
