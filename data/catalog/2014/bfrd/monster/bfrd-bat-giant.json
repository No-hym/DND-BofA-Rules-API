      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one creature. _Hit:_ 5 (1d6+2) piercing damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одно существо. Попадание: 5 (1к6+2) колющего урона.",
          "external_id": "bfrd_bat-giant_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 0,
          "parent": "bfrd_bat-giant",
          "ru_source": "template"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The bat releases a dizzying screech at one creature within 10 feet of it. If the target can hear the screech, it must succeed on a DC 12 CON save or be disoriented until the end of its next turn. When a disoriented creature moves, it moves in a random direction.",
          "desc_ru": "Действие «Диззйинг Скрееч»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_bat-giant_dizzying-screech",
          "name": "Dizzying Screech",
          "name_ru": "Диззйинг Скрееч",
          "order_in_statblock": 0,
          "parent": "bfrd_bat-giant",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The bat can't use its keensense while deafened.",
          "desc_ru": "Особенность «Ечолокатион». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_bat-giant_echolocation",
          "name": "Echolocation",
          "name_ru": "Ечолокатион",
          "parent": "bfrd_bat-giant",
          "ru_source": "derived"
        },
        {
          "desc": "The bat's Perception is 16 when perceiving by hearing.",
          "desc_ru": "Особенность «Хеигхтенед Хеаринг». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
