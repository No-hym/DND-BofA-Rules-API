    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one creature. _Hit:_ 5 (1d6+2) bludgeoning damage, and the target is grappled (escape DC 12). The crab has two pincers, each of which can grapple only one target.",
          "desc_ru": "Действие «Пинкер»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_crab-giant_pincer",
          "name": "Pincer",
          "name_ru": "Пинкер",
          "order_in_statblock": 0,
          "parent": "bfrd_crab-giant",
          "ru_source": "derived"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "One breathing creature grappled by the crab must succeed on a DC 12 STR save or be unable to speak or cast spells with verbal components and begin suffocating, as the crab squeezes the air from the target's lungs. This effect lasts until the grapple ends.",
          "desc_ru": "Действие «Пинкер Пинч»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_crab-giant_pincer-pinch",
          "name": "Pincer Pinch",
          "name_ru": "Пинкер Пинч",
          "order_in_statblock": 0,
          "parent": "bfrd_crab-giant",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The crab can breathe air and water.",
          "desc_ru": "Может дышать как воздухом, так и водой.",
          "external_id": "bfrd_crab-giant_amphibious",
          "name": "Amphibious",
