    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Ranged Weapon Attack:_ +3 to hit, range 150/600 ft., one target. _Hit:_ 5 (1d8+1) piercing damage.",
          "desc_ru": "Атака оружием дальнего боя: +3 к попаданию, дистанция 150/600 фт., одна цель. Попадание: 5 (1к8+1) колющего урона.",
          "external_id": "bfrd_hobgoblin_longbow",
          "name": "Longbow",
          "name_ru": "Длинный лук",
          "order_in_statblock": 2,
          "parent": "bfrd_hobgoblin",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +3 to hit, reach 5 ft., one target. _Hit:_ 5 (1d8+1) slashing damage, or 6 (1d10+1) slashing damage if used with two hands.",
          "desc_ru": "Атака оружием ближнего боя: +3 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к8+1) рубящего урона, или 6 (1к10+1) рубящего урона при использовании двумя руками.",
          "external_id": "bfrd_hobgoblin_longsword",
          "name": "Longsword",
          "name_ru": "Длинный меч",
          "order_in_statblock": 1,
          "parent": "bfrd_hobgoblin",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "The hobgoblin makes two Longsword or Longbow attacks.",
          "desc_ru": "Действие «Мултиаттак»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_hobgoblin_multiattack",
          "name": "Multiattack",
          "name_ru": "Мултиаттак",
          "order_in_statblock": 0,
          "parent": "bfrd_hobgoblin",
          "ru_source": "derived"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The hobgoblin briefly studies one creature it can see within 30 feet of it. It has advantage on the next attack roll it makes against that creature before the start of the hobgoblin's next turn.",
          "desc_ru": "Действие «Тактикал Аналйсис»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_hobgoblin_tactical-analysis",
          "name": "Tactical Analysis",
          "name_ru": "Тактикал Аналйсис",
          "order_in_statblock": 0,
          "parent": "bfrd_hobgoblin",
          "ru_source": "derived"
        }
      ]
