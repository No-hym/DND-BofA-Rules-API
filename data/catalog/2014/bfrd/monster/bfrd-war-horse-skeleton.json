      "actions": [
        {
          "action_type": "BONUS_ACTION",
          "desc": "When a creature the war horse skeleton can see hits it with a melee attack while within 5 feet of it, the skeleton can make one Hooves attack against the attacker.",
          "desc_ru": "Действие «Коунтераттак»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_war-horse-skeleton_counterattack",
          "name": "Counterattack",
          "name_ru": "Коунтераттак",
          "order_in_statblock": 0,
          "parent": "bfrd_war-horse-skeleton",
          "ru_source": "derived",
          "uses_param": 6,
          "uses_type": "RECHARGE_ON_ROLL"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +6 to hit, reach 5 ft., one target. _Hit:_ 11 (2d6+4) bludgeoning damage.",
          "desc_ru": "Атака оружием ближнего боя: +6 к попаданию, досягаемость 5 фт., одна цель. Попадание: 11 (2к6+4) дробящего урона.",
          "external_id": "bfrd_war-horse-skeleton_hooves",
          "name": "Hooves",
          "name_ru": "Хоовес",
          "order_in_statblock": 0,
          "parent": "bfrd_war-horse-skeleton",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "While the war horse skeleton remains motionless and prone, it is indistinguishable from an inanimate war horse skeleton.",
          "desc_ru": "Особенность «Фалсе Аппеаранке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_war-horse-skeleton_false-appearance",
          "name": "False Appearance",
          "name_ru": "Фалсе Аппеаранке",
          "parent": "bfrd_war-horse-skeleton",
          "ru_source": "derived"
        },
        {
          "desc": "The skeleton doesn't require air, food, drink, or sleep.",
          "desc_ru": "Особенность «Нежить Натуре». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_war-horse-skeleton_undead-nature",
          "name": "Undead Nature",
          "name_ru": "Нежить Натуре",
          "parent": "bfrd_war-horse-skeleton",
          "ru_source": "derived"
        },
        {
          "desc": "The skeleton is immune to poison damage, to exhaustion, and to the poisoned condition.",
          "desc_ru": "Особенность «Нежить Ресилиенке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_war-horse-skeleton_undead-resilience",
