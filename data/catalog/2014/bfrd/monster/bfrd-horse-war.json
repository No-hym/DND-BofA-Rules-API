    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +6 to hit, reach 5 ft., one target. _Hit:_ 8 (1d8+4) bludgeoning damage.",
          "desc_ru": "Атака оружием ближнего боя: +6 к попаданию, досягаемость 5 фт., одна цель. Попадание: 8 (1к8+4) дробящего урона.",
          "external_id": "bfrd_horse-war_hooves",
          "name": "Hooves",
          "name_ru": "Хоовес",
          "order_in_statblock": 0,
          "parent": "bfrd_horse-war",
          "ru_source": "template"
        },
        {
          "action_type": "REACTION",
          "desc": "If the horse's rider is subjected to an effect that would knock it prone or dismount it, the horse can shift its body to assist the rider. The rider has advantage on the check or save to avoid the effect.",
          "desc_ru": "Действие «Траинед Шифт»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_horse-war_trained-shift",
          "name": "Trained Shift",
          "name_ru": "Траинед Шифт",
          "order_in_statblock": 0,
          "parent": "bfrd_horse-war",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "If the horse moves at least 20 feet straight toward a creature and then hits it with a Hooves attack on the same turn, that target must succeed on a DC 14 STR save or be knocked prone. If the target is prone, the horse can make another Hooves attack against it as a bonus action.",
          "desc_ru": "Особенность «Трамплинг Чарге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_horse-war_trampling-charge",
          "name": "Trampling Charge",
          "name_ru": "Трамплинг Чарге",
          "parent": "bfrd_horse-war",
          "ru_source": "derived"
        }
      ]
