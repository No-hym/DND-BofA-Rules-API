        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one target. _Hit:_ 5 (1d6+2) piercing damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к6+2) колющего урона.",
          "external_id": "bfrd_lizardfolk_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 1,
          "parent": "bfrd_lizardfolk",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one target. _Hit:_ 5 (1d6+2) bludgeoning damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к6+2) дробящего урона.",
          "external_id": "bfrd_lizardfolk_heavy-club",
          "name": "Heavy Club",
          "name_ru": "Хеавй дубинка",
          "order_in_statblock": 2,
          "parent": "bfrd_lizardfolk",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee or Ranged Weapon Attack:_ +4 to hit, reach 5 ft. or range 30/120 ft., one target. _Hit:_ 5 (1d6+2) piercing damage.",
          "desc_ru": "Атака оружием ближнего или дальнего боя: +4 к попаданию, досягаемость 5 фт. или дистанция 30/120 фт., одна цель. Попадание: 5 (1к6+2) колющего урона.",
          "external_id": "bfrd_lizardfolk_javelin",
          "name": "Javelin",
          "name_ru": "Метательное копьё",
          "order_in_statblock": 3,
          "parent": "bfrd_lizardfolk",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "The lizardfolk makes one Bite attack and one Heavy Club attack, or it makes two Javelin attacks.",
          "desc_ru": "Действие «Мултиаттак»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_lizardfolk_multiattack",
          "name": "Multiattack",
          "name_ru": "Мултиаттак",
          "order_in_statblock": 0,
          "parent": "bfrd_lizardfolk",
          "ru_source": "derived"
        },
        {
          "action_type": "REACTION",
          "desc": "If a creature misses the lizardfolk with an attack and the lizardfolk is wielding a shield, the lizardfolk can shove its shield into the creature. The attacker must succeed on a DC 12 STR save or be pushed up to 10 feet away from the lizardfolk and knocked prone.",
          "desc_ru": "Действие «Шовинг Коунтер»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_lizardfolk_shoving-counter",
          "name": "Shoving Counter",
          "name_ru": "Шовинг Коунтер",
          "order_in_statblock": 0,
          "parent": "bfrd_lizardfolk",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The lizardfolk's Perception is 18 when perceiving by smell or taste.",
          "desc_ru": "Особенность «Хеигхтенед Смелл и Тасте». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
