    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +5 to hit, reach 5 ft., one target. _Hit:_ 8 (2d4+3) bludgeoning damage.",
          "desc_ru": "Атака оружием ближнего боя: +5 к попаданию, досягаемость 5 фт., одна цель. Попадание: 8 (2к4+3) дробящего урона.",
          "external_id": "bfrd_goat-giant_ram",
          "name": "Ram",
          "name_ru": "Рам",
          "order_in_statblock": 0,
          "parent": "bfrd_goat-giant",
          "ru_source": "template"
        },
        {
          "action_type": "REACTION",
          "desc": "When the goat takes damage, it can release a high-pitched scream, frightening creatures within 10 feet of it. Each creature in that area that can hear the scream must succeed on a DC 13 WIS save or be frightened until the end of its next turn. A creature frightened in this way can't be frightened by this goat's Terrifying Scream again for the next 24 hours.",
          "desc_ru": "Действие «Террифйинг Скреам»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_goat-giant_terrifying-scream",
          "name": "Terrifying Scream",
          "name_ru": "Террифйинг Скреам",
          "order_in_statblock": 0,
          "parent": "bfrd_goat-giant",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "If the goat moves at least 20 feet straight toward a target and then hits it with a Ram attack on the same turn, the target takes an extra 5 (2d4) bludgeoning damage. If the target is a creature, it must succeed on a DC 13 STR save or be knocked prone.",
          "desc_ru": "Особенность «Чарге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_goat-giant_charge",
          "name": "Charge",
          "name_ru": "Чарге",
          "parent": "bfrd_goat-giant",
          "ru_source": "derived"
        }
      ]
    },
