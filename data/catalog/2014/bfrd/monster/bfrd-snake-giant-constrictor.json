      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +6 to hit, reach 10 ft., one creature. _Hit:_ 10 (2d6+3) piercing damage.",
          "desc_ru": "Атака оружием ближнего боя: +6 к попаданию, досягаемость 10 фт., одно существо. Попадание: 10 (2к6+3) колющего урона.",
          "external_id": "bfrd_snake-giant-constrictor_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 1,
          "parent": "bfrd_snake-giant-constrictor",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +6 to hit, reach 5 ft., one creature. _Hit:_ 12 (2d8+3) bludgeoning damage, and the target is grappled (escape DC 14). Until this grapple ends, the creature is restrained, and the snake can't Constrict another target.",
          "desc_ru": "Действие «Констрикт»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-giant-constrictor_constrict",
          "name": "Constrict",
          "name_ru": "Констрикт",
          "order_in_statblock": 2,
          "parent": "bfrd_snake-giant-constrictor",
          "ru_source": "derived"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "One creature grappled by the snake must succeed on a DC 14 STR or take 9 (2d8) bludgeoning damage and begin suffocating. The creature continues suffocating until the grapple ends.",
          "desc_ru": "Действие «Круш»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-giant-constrictor_crush",
          "name": "Crush",
          "name_ru": "Круш",
          "order_in_statblock": 0,
          "parent": "bfrd_snake-giant-constrictor",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "The snake makes one Bite attack and one Constrict attack, or it makes two Bite attacks.",
          "desc_ru": "Действие «Мултиаттак»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
