      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one creature. _Hit:_ 5 (1d6+2) piercing damage, and the target must succeed on a DC 11 CON save or take 7 (2d6) poison damage. If the poison damage reduces the target to 0 HP, the target is stable but poisoned for 1 hour, even after regaining HP, and is paralyzed while poisoned in this way.",
          "desc_ru": "Действие «Укус»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_insect-giant-centipede_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 0,
          "parent": "bfrd_insect-giant-centipede",
          "ru_source": "derived"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The centipede moves up to its speed toward a hostile creature that it can see.",
          "desc_ru": "Действие «Свифт Хунтер»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
