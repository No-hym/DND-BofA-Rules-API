    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee or Ranged Weapon Attack:_ +6 to hit, reach 5 ft. or range 30/120 ft., one target. _Hit:_ 11 (2d6+4) piercing damage in melee or 7 (1d6+4) piercing damage at range.",
          "desc_ru": "Действие «Метательное копьё»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_bugbear_javelin",
          "name": "Javelin",
          "name_ru": "Метательное копьё",
          "order_in_statblock": 1,
          "parent": "bfrd_bugbear",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +5 to hit, reach 5 ft., one target. _Hit:_ 12 (2d8+3) piercing damage. A surprised target takes an extra 4 (1d8) piercing damage and must succeed on a DC 13 CON save or be stunned until the end of its next turn.",
          "desc_ru": "Действие «Спикед дубинка»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_bugbear_spiked-club",
          "name": "Spiked Club",
          "name_ru": "Спикед дубинка",
          "order_in_statblock": 0,
          "parent": "bfrd_bugbear",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "A melee weapon deals one extra die of its damage when the bugbear hits with it (included in the attack).",
          "desc_ru": "Особенность «Брутал». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
