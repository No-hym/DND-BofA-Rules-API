        }
      ],
      "traits": [
        {
          "desc": "The quipper has advantage on melee attack rolls against any creature that doesn't have all its HP.",
          "desc_ru": "Особенность «Крови Френзй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_quipper_blood-frenzy",
          "name": "Blood Frenzy",
          "name_ru": "Крови Френзй",
          "parent": "bfrd_quipper",
          "ru_source": "derived"
        },
        {
          "desc": "The quipper's Perception is 13 when perceiving by smell.",
          "desc_ru": "Особенность «Хеигхтенед Смелл». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_quipper_heightened-smell",
