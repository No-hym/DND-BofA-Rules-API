    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +3 to hit, reach 5 ft., one creature. _Hit:_ 3 (1d4+1) piercing damage, and the target must succeed on a DC 11 CON save or take 5 (2d4) poison damage.",
          "desc_ru": "Действие «Укус»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-flying_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 0,
          "parent": "bfrd_snake-flying",
          "ru_source": "derived"
        },
        {
          "action_type": "REACTION",
          "desc": "When a creature the snake can see attacks it, the snake can move up to 5 feet. If this movement puts the snake out of reach of the attack, the attack misses.",
          "desc_ru": "Действие «Рефлексиве Ескапе»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-flying_reflexive-escape",
          "name": "Reflexive Escape",
          "name_ru": "Рефлексиве Ескапе",
          "order_in_statblock": 0,
          "parent": "bfrd_snake-flying",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The snake doesn't provoke opportunity attacks when it flies out of an enemy's reach.",
          "desc_ru": "Особенность «Флйбй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-flying_flyby",
