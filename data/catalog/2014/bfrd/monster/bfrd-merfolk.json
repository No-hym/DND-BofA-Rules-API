    "subentities": {
      "actions": [
        {
          "action_type": "REACTION",
          "desc": "When a creature the merfolk can see hits it with a melee attack while within 5 feet of it, the merfolk can twist its body to scrape the attacker's arm or similar attacking appendage across the rough coral of its armor. The attacker must succeed on a DC 11 DEX save or have disadvantage on the next attack roll it makes before the end of its next turn, as its attacking appendage hurts from the abrasion.",
          "desc_ru": "Действие «Корал Скрапе»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_merfolk_coral-scrape",
          "name": "Coral Scrape",
          "name_ru": "Корал Скрапе",
          "order_in_statblock": 0,
          "parent": "bfrd_merfolk",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +3 to hit, reach 5 ft., one target. _Hit:_ 4 (1d6+1) piercing damage.",
          "desc_ru": "Атака оружием ближнего боя: +3 к попаданию, досягаемость 5 фт., одна цель. Попадание: 4 (1к6+1) колющего урона.",
          "external_id": "bfrd_merfolk_coral-spear",
          "name": "Coral Spear",
          "name_ru": "Корал копьё",
          "order_in_statblock": 0,
          "parent": "bfrd_merfolk",
          "ru_source": "template"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The merfolk takes the Dash or Disengage action.",
          "desc_ru": "Действие «Нимбле Руш»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_merfolk_nimble-rush",
          "name": "Nimble Rush",
          "name_ru": "Нимбле Руш",
          "order_in_statblock": 0,
          "parent": "bfrd_merfolk",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Ranged Weapon Attack:_ +3 to hit, range 20/60 ft., one target. _Hit:_ 3 (1d4+1) slashing damage.",
          "desc_ru": "Атака оружием дальнего боя: +3 к попаданию, дистанция 20/60 фт., одна цель. Попадание: 3 (1к4+1) рубящего урона.",
          "external_id": "bfrd_merfolk_sharpened-shell",
          "name": "Sharpened Shell",
          "name_ru": "Шарпенед Шелл",
          "order_in_statblock": 1,
          "parent": "bfrd_merfolk",
          "ru_source": "template"
        }
      ],
