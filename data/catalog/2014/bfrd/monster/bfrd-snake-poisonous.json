    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +3 to hit, reach 5 ft., one creature. _Hit:_ 3 (1d4+1) piercing damage, and the target must succeed on a DC 10 CON save or take 2 (1d4) poison damage.",
          "desc_ru": "Действие «Укус»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-poisonous_bite",
          "name": "Bite",
          "name_ru": "Укус",
          "order_in_statblock": 0,
          "parent": "bfrd_snake-poisonous",
          "ru_source": "derived"
        },
        {
          "action_type": "REACTION",
          "desc": "When a creature the snake can see hits it with a melee attack while within 5 feet of it, the snake can make a quick nip at the creature. The attacker must succeed on a DC 10 CON save or be poisoned until the end of its next turn.",
          "desc_ru": "Действие «Рефлексиве Нип»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_snake-poisonous_reflexive-nip",
