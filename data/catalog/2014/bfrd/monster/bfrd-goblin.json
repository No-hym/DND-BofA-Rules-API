    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "The goblin moves up to half its speed toward a creature it can see. Each friendly goblin within 30 feet of the goblin can use its reaction to join the gang up and move up to half its speed toward the same target. This movement doesn't provoke opportunity attacks. If the initiating goblin is within 5 feet of the target, the target must make a DC 12 DEX save, taking 5 (2d4) bludgeoning damage on a failed save, or half as much damage on a successful one. For each goblin after the first that participated in the gang up and that is within 10 feet of the target, the damage increases by 1 as arrows, knives, sharp pocket scraps, and similar \"weapons\" fly at the target from all angles. Afterwards, each goblin after the first that participated in the gang up can't use Gang Up until it finishes a short or long rest.",
          "desc_ru": "Действие «Ганг Уп»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_goblin_gang-up",
          "name": "Gang Up",
          "name_ru": "Ганг Уп",
          "order_in_statblock": 2,
          "parent": "bfrd_goblin",
          "ru_source": "derived",
          "uses_param": 1,
          "uses_type": "PER_DAY"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The goblin takes the Disengage or Hide action.",
          "desc_ru": "Действие «Нимбле Ескапе»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_goblin_nimble-escape",
          "name": "Nimble Escape",
          "name_ru": "Нимбле Ескапе",
          "order_in_statblock": 0,
          "parent": "bfrd_goblin",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one target. _Hit:_ 5 (1d6+2) slashing damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к6+2) рубящего урона.",
          "external_id": "bfrd_goblin_scimitar",
          "name": "Scimitar",
          "name_ru": "Скимитар",
          "order_in_statblock": 0,
          "parent": "bfrd_goblin",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Ranged Weapon Attack:_ +4 to hit, range 80/320 ft., one target. _Hit:_ 5 (1d6+2) piercing damage.",
          "desc_ru": "Атака оружием дальнего боя: +4 к попаданию, дистанция 80/320 фт., одна цель. Попадание: 5 (1к6+2) колющего урона.",
          "external_id": "bfrd_goblin_shortbow",
