      "traits": [
        {
          "desc": "The sand dragon has advantage on Dex (Stealth) checks made to hide in sandy terrain.",
          "desc_ru": "Особенность «Санд Камоуфлаге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_dragon-sand-wyrmling_sand-camouflage",
          "name": "Sand Camouflage",
          "name_ru": "Санд Камоуфлаге",
          "parent": "tob3_dragon-sand-wyrmling",
          "ru_source": "derived"
        },
        {
          "desc": "Is infused with elemental power and it requires only half the air food and drink that a typical dragon if its size needs.",
          "desc_ru": "Особенность «Сандй Натуре». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_dragon-sand-wyrmling_sandy-nature",
          "name": "Sandy Nature",
          "name_ru": "Сандй Натуре",
          "parent": "tob3_dragon-sand-wyrmling",
          "ru_source": "derived"
        },
        {
          "desc": "The first time it hits a target with melee weapon attack target: DC 13 Con save or have disadvantage on attack rolls and ability checks until end of its next turn.",
          "desc_ru": "Особенность «Стингинг Санд». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
