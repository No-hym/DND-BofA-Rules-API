      "actions": [
        {
          "action_type": "ACTION",
          "desc": "The chaos-spawn goblin makes two attacks with its scimitar.",
          "desc_ru": "Мультиатака. Существо совершает 2 атаки: две — атака «Скимитар».",
          "external_id": "ccdx_chaos-spawn-goblin_multiattack",
          "name": "Multiattack",
          "name_ru": "Мултиаттак",
          "order_in_statblock": 0,
          "parent": "ccdx_chaos-spawn-goblin",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "The chaos-spawn goblin targets one creature that it can sense within 30 feet of it. The target must make a DC 12 Intelligence saving throw, taking 7 (2d6) psychic damage on a failed save, or half as much damage on a successful one.",
          "desc_ru": "Действие «Психический Стаб»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "ccdx_chaos-spawn-goblin_psychic-stab",
          "name": "Psychic Stab",
          "name_ru": "Психический Стаб",
          "order_in_statblock": 2,
          "parent": "ccdx_chaos-spawn-goblin",
          "ru_source": "derived",
          "uses_param": 6,
          "uses_type": "RECHARGE_ON_ROLL"
        },
        {
          "action_type": "ACTION",
          "desc": "Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 5 (1d6 + 2) slashing damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к6+2) рубящего урона.",
          "external_id": "ccdx_chaos-spawn-goblin_scimitar",
          "name": "Scimitar",
          "name_ru": "Скимитар",
          "order_in_statblock": 1,
          "parent": "ccdx_chaos-spawn-goblin",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "The chaos-spawn goblin can take the Disengage or Hide action as a bonus action on each of its turns.",
          "desc_ru": "Особенность «Нимбле Ескапе». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
