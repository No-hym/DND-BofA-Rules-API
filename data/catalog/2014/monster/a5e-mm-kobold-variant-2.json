      "traits": [
        {
          "desc": "The kobold has advantage on attack rolls against a creature if at least one of the kobolds allies is within 5 feet of the creature and not incapacitated.",
          "desc_ru": "Особенность «Пак Тактикс». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "a5e-mm_kobold_pack-tactics",
          "name": "Pack Tactics",
          "name_ru": "Пак Тактикс",
          "parent": "a5e-mm_kobold",
          "ru_source": "derived"
        },
        {
          "desc": "While in sunlight, the kobold has disadvantage on attack rolls, as well as on Perception checks that rely on sight.",
          "desc_ru": "Особенность «Сунлигхт Сенситивитй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
