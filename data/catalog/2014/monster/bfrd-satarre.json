    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one target. _Hit:_ 5 (1d6+2) piercing damage plus 3 (1d6) necrotic damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 5 (1к6+2) колющего урона плюс 3 (1к6) некротического урона.",
          "external_id": "bfrd_satarre_claw",
          "name": "Claw",
          "name_ru": "Коготь",
          "order_in_statblock": 1,
          "parent": "bfrd_satarre",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "The satarre makes two Claw or Spear attacks.",
          "desc_ru": "Действие «Мултиаттак»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_satarre_multiattack",
          "name": "Multiattack",
          "name_ru": "Мултиаттак",
          "order_in_statblock": 0,
          "parent": "bfrd_satarre",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "_Melee or Ranged Weapon Attack:_ +4 to hit, reach 5 ft. or range 20/60 ft., one target. _Hit:_ 5 (1d6+2) piercing damage plus 3 (1d6) necrotic damage.",
          "desc_ru": "Атака оружием ближнего или дальнего боя: +4 к попаданию, досягаемость 5 фт. или дистанция 20/60 фт., одна цель. Попадание: 5 (1к6+2) колющего урона плюс 3 (1к6) некротического урона.",
          "external_id": "bfrd_satarre_spear",
          "name": "Spear",
          "name_ru": "Копьё",
          "order_in_statblock": 2,
          "parent": "bfrd_satarre",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "The satarre is resistant to the blinded, charmed, deafened, frightened, stunned, and unconscious conditions.",
          "desc_ru": "Особенность «Воид Стренгт». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_satarre_void-strength",
          "name": "Void Strength",
          "name_ru": "Воид Стренгт",
          "parent": "bfrd_satarre",
          "ru_source": "derived"
        },
        {
          "desc": "The satarre's weapon attacks are magical. When the satarre hits with any weapon, the weapon deals an extra 1d6 necrotic damage (included in the attack).",
          "desc_ru": "Особенность «Воид Веапонс». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_satarre_void-weapons",
          "name": "Void Weapons",
          "name_ru": "Воид Веапонс",
          "parent": "bfrd_satarre",
          "ru_source": "derived"
        }
      ]
