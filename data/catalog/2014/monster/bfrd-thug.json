    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "_Melee Weapon Attack:_ +4 to hit, reach 5 ft., one target. _Hit:_ 7 (2d4+2) bludgeoning damage.",
          "desc_ru": "Атака оружием ближнего боя: +4 к попаданию, досягаемость 5 фт., одна цель. Попадание: 7 (2к4+2) дробящего урона.",
          "external_id": "bfrd_thug_club",
          "name": "Club",
          "name_ru": "Дубинка",
          "order_in_statblock": 0,
          "parent": "bfrd_thug",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "_Ranged Weapon Attack:_ +2 to hit, range 100/400 ft., one target. _Hit:_ 5 (1d10) piercing damage.",
          "desc_ru": "Атака оружием дальнего боя: +2 к попаданию, дистанция 100/400 фт., одна цель. Попадание: 5 (1к10) колющего урона.",
          "external_id": "bfrd_thug_heavy-crossbow",
          "name": "Heavy Crossbow",
          "name_ru": "Хеавй арбалет",
          "order_in_statblock": 1,
          "parent": "bfrd_thug",
          "ru_source": "template"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The thug employs unscrupulous tactics to hit its opponent in a vulnerable spot. One creature the thug can see within 5 feet of it must make a DC 12 DEX save. On a failure, the target takes 2 (1d4) bludgeoning damage.",
          "desc_ru": "Действие «Сукер Пунч»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_thug_sucker-punch",
          "name": "Sucker Punch",
          "name_ru": "Сукер Пунч",
          "order_in_statblock": 0,
          "parent": "bfrd_thug",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "A melee weapon deals one extra die of its damage when the thug hits with it (included in the attack).",
          "desc_ru": "Особенность «Брутал». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_thug_brutal",
          "name": "Brutal",
          "name_ru": "Брутал",
          "parent": "bfrd_thug",
          "ru_source": "derived"
        },
        {
          "desc": "The thug has advantage on attack rolls against a creature if at least one of the thug's allies is within 5 feet of the creature and the ally isn't incapacitated.",
          "desc_ru": "Совершает броски атаки по существу с преимуществом, если хотя бы один его союзник находится в пределах 5 футов от существа и этот союзник не выведен из строя.",
          "external_id": "bfrd_thug_pack-tactics",
          "name": "Pack Tactics",
          "name_ru": "Пак Тактикс",
          "parent": "bfrd_thug",
          "ru_source": "template"
        }
      ]
