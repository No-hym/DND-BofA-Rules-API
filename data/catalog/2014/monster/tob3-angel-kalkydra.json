    "subentities": {
      "actions": [
        {
          "action_type": "REACTION",
          "desc": "When hit by an attack it surrounds itself in a fiery nimbus searing attacker: 9 (2d8) fire and 9 (2d8) radiant and nimbus sheds bright light in 30' radius and dim light an additional 30'. Until start of kalkydra's next turn a creature within 5 ft. of kalkydra that hits it with melee attack takes 9 (2d8) fire and 9 (2d8) radiant.",
          "desc_ru": "Действие «Солар Нимбус»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_angel-kalkydra_solar-nimbus",
          "name": "Solar Nimbus",
          "name_ru": "Солар Нимбус",
          "order_in_statblock": 0,
          "parent": "tob3_angel-kalkydra",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "Its weapon attacks are magical. When it hits with any weapon deals extra 4d8 radiant (included below).",
          "desc_ru": "Особенность «Ангелик Веапонс». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
