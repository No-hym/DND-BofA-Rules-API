    "subentities": {
      "actions": [
        {
          "action_type": "BONUS_ACTION",
          "desc": "Magically shifts from Material Plane to Ethereal or vice versa. Drake can bring creatures grappled by it into the Ethereal Plane with it. A creature not native to Ethereal Plane returns to Material Plane in 1d4 rounds if brought to the plane while grappled by drake.",
          "desc_ru": "Действие «Етереал Степ»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_drake-ethereal_ethereal-step",
          "name": "Ethereal Step",
          "name_ru": "Етереал Степ",
          "order_in_statblock": 0,
          "parent": "tob3_drake-ethereal",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "Can see 60' into the Ethereal Plane when on the Material Plane and vice versa.",
          "desc_ru": "Особенность «Етереал Сигхт». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
