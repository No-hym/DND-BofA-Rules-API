    "subentities": {
      "traits": [
        {
          "desc": "Attacks made within 60' of the bone collector score a critical hit on a roll of 19 or 20.",
          "desc_ru": "Особенность «Калл Граве». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_bone-collector_call-of-the-grave",
          "name": "Call of the Grave",
          "name_ru": "Калл Граве",
          "parent": "tob3_bone-collector",
          "ru_source": "derived"
        },
        {
          "desc": "Can pinpoint by scent location of Undead creatures and creatures that have been dead no longer than 1 week within 60' of it and can sense the general direction of such creatures within 1 mile of it.",
          "desc_ru": "Особенность «Смерти Сенсе». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
