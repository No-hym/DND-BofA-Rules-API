    "subentities": {
      "traits": [
        {
          "desc": "Its shell plates rattle constantly creating a droning distracting noise. When a creature casts a spell with verbal component while within 30' of the troll that creature must make DC 15 Con save or lose the spell.",
          "desc_ru": "Особенность «Дистрактинг Раттле». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_troll-rattleback_distracting-rattle",
          "name": "Distracting Rattle",
          "name_ru": "Дистрактинг Раттле",
          "parent": "tob3_troll-rattleback",
          "ru_source": "derived"
        },
        {
          "desc": "While in dim light or darkness has advantage on Wis (Perception) checks that rely on sight.",
          "desc_ru": "Особенность «Ночной Хунтерс». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_troll-rattleback_night-hunters",
          "name": "Night Hunters",
          "name_ru": "Ночной Хунтерс",
          "parent": "tob3_troll-rattleback",
          "ru_source": "derived"
        },
        {
          "desc": "Regains 10 hp at the start of its turn. If it takes fire this trait doesn’t function at start of its next turn. It dies only if it starts its turn with 0 hp and doesn’t regenerate.",
          "desc_ru": "Особенность «Регенератион». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_troll-rattleback_regeneration",
          "name": "Regeneration",
          "name_ru": "Регенератион",
          "parent": "tob3_troll-rattleback",
          "ru_source": "derived"
        }
      ]
