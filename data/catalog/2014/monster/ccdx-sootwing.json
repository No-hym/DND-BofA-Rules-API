      "actions": [
        {
          "action_type": "ACTION",
          "desc": "Melee Weapon Attack: +3 to hit, reach 5 ft., one target. Hit: 4 (1d6 + 1) piercing damage.",
          "desc_ru": "Атака оружием ближнего боя: +3 к попаданию, досягаемость 5 фт., одна цель. Попадание: 4 (1к6+1) колющего урона.",
          "external_id": "ccdx_sootwing_proboscis",
          "name": "Proboscis",
          "name_ru": "Пробоскис",
          "order_in_statblock": 0,
          "parent": "ccdx_sootwing",
          "ru_source": "template"
        },
        {
          "action_type": "ACTION",
          "desc": "A 20-foot radius cloud of smoldering ash disperses from the sootwing. Each creature in that area must make a DC 11 Constitution saving throw. On a failure, a creature takes 4 (1d8) fire damage and is blinded until the end of its next turn. On a success, a creature takes half the damage and isn't blinded.",
          "desc_ru": "Действие «Соотй Вингс»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "ccdx_sootwing_sooty-wings",
          "name": "Sooty Wings",
          "name_ru": "Соотй Вингс",
          "order_in_statblock": 1,
          "parent": "ccdx_sootwing",
          "ru_source": "derived",
          "uses_param": 1,
          "uses_type": "PER_DAY"
        }
      ],
      "traits": [
        {
          "desc": "The giant moth has advantage on Wisdom (Perception) checks that rely on smell.",
          "desc_ru": "Совершает проверки Мудрости (Восприятие) с преимуществом, если они полагаются на обоняние.",
          "external_id": "ccdx_sootwing_antennae",
