    "source_data": {
      "actions_json": "[{\"name\": \"Strangle\", \"desc\": \"Melee Weapon Attack: +4 to hit, reach 10 ft., one Medium or smaller creature that is surprised  grappled by the kech  or that can't see the kech. Hit: 9 (2d6 + 2) bludgeoning damage  and the target is pulled 5 feet towards the kech and grappled (escape DC 12). Until this grapple ends  the kech automatically hits with the Strangle attack and the target can't breathe.\"}, {\"name\": \"Claw\", \"desc\": \"Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 9 (2d6 + 2) slashing damage.\"}, {\"name\": \"Stealthy Sneak\", \"desc\": \"The kech moves up to half its Speed without provoking opportunity attacks. It can then attempt to hide.\"}]",
