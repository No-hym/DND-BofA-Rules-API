          "name": "Beak",
          "name_ru": "Клюв",
          "order_in_statblock": 0,
          "parent": "bfrd_hawk-blood",
          "ru_source": "template"
        },
        {
          "action_type": "BONUS_ACTION",
          "desc": "The hawk takes the Disengage or Dodge action. It can use this bonus action only while flying.",
          "desc_ru": "Действие «Евасиве Флигхт»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_hawk-blood_evasive-flight",
          "name": "Evasive Flight",
          "name_ru": "Евасиве Флигхт",
          "order_in_statblock": 0,
          "parent": "bfrd_hawk-blood",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The hawk's Perception is 19 when perceiving by sight.",
          "desc_ru": "Особенность «Хеигхтенед Сигхт». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "bfrd_hawk-blood_heightened-sight",
          "name": "Heightened Sight",
          "name_ru": "Хеигхтенед Сигхт",
          "parent": "bfrd_hawk-blood",
          "ru_source": "derived"
        },
        {
          "desc": "The hawk has advantage on attack rolls against a creature if at least one of the hawk's allies is within 5 feet of the creature and the ally isn't incapacitated.",
          "desc_ru": "Совершает броски атаки по существу с преимуществом, если хотя бы один его союзник находится в пределах 5 футов от существа и этот союзник не выведен из строя.",
          "external_id": "bfrd_hawk-blood_pack-tactics",
