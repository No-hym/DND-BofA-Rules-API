    "subentities": {
      "traits": [
        {
          "desc": "Magically transmit simple messages and images to any creature within 90' of it that can understand a language. This telepathy doesn't allow receiver to telepathically respond.",
          "desc_ru": "Особенность «Лимитед Телепатй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_harpy-plague_limited-telepathy",
          "name": "Limited Telepathy",
          "name_ru": "Лимитед Телепатй",
          "parent": "tob3_harpy-plague",
          "ru_source": "derived"
        },
        {
          "desc": "A creature infected with harpy's plague becomes contagious 24 hrs after contracting the disease. When a creature starts its turn within 5 ft. of contagious target that creature must make DC 15 Con save or also contract harpy's plague disease.",
          "desc_ru": "Особенность «Вируленке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
