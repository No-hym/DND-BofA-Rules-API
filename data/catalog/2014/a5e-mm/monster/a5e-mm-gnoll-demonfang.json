      "traits": [
        {
          "desc": "The gnoll radiates a Chaotic and Evil aura.",
          "desc_ru": "Особенность «Алигнед». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "a5e-mm_gnoll-demonfang_aligned",
          "name": "Aligned",
          "name_ru": "Алигнед",
          "parent": "a5e-mm_gnoll-demonfang",
          "ru_source": "derived"
        },
        {
          "desc": "If the gnoll demonfang is turned or affected by dispel evil and good or a similar effect, it transforms into an ordinary gnoll. Any damage it has taken carries over to its new form. If this damage exceeds its maximum hit points, it dies.",
