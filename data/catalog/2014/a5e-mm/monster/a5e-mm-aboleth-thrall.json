          "parent": "a5e-mm_aboleth-thrall",
          "ru_source": "template"
        },
        {
          "action_type": "REACTION",
          "desc": "When a creature within 5 feet of the thrall that the thrall can see hits an aboleth with an attack, the thrall can make itself the target of the attack instead.",
          "desc_ru": "Действие «Селф-сакрифике»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "a5e-mm_aboleth-thrall_self-sacrifice",
          "name": "Self-Sacrifice",
          "name_ru": "Селф-сакрифике",
          "order_in_statblock": 0,
          "parent": "a5e-mm_aboleth-thrall",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "The aboleth thrall can breathe water and air, but must bathe in water for 1 hour for every 12 hours it spends dry or it begins to suffocate. It is magically charmed by the aboleth.",
          "desc_ru": "Особенность «Сеа Чангед». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "a5e-mm_aboleth-thrall_sea-changed",
