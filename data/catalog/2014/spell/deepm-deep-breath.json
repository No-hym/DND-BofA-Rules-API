    "source_data": {
      "attack_roll": false,
      "casting_time": "action",
      "concentration": false,
      "desc": "The recipient of this spell can breathe and function normally in thin atmosphere, suffering no ill effect at altitudes of up to 20,000 feet. If more than one creature is touched during the casting, the duration is divided evenly among all creatures touched.\n",
