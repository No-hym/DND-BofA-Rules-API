  "translations": {
    "en": {
      "description": "You draw blood from the corpse of a creature that has been dead for no more than 24 hours and magically fashion it into a spear of frozen blood. This functions as a +1 spear that does cold damage instead of piercing damage. If the spear leaves your hand for more than 1 round, it melts and the spell ends.",
      "name": "Sanguine Spear",
      "source_version": "snapshot",
      "status": "source"
    },
    "ru": {
      "description": "Вы берёте кровь из трупа существа, которое было мертво не более 24 часов, и магически формируете её в копьё замороженной крови. Это функционирует как копьё +1, которое наносит урон холодом вместо колющего урона. Если копьё покидает вашу руку более чем на 1 раунд, оно тает, и заклинание заканчивается.",
      "glossary_version": "v1",
      "name": "Кровавое копьё",
      "source_version": "snapshot",
      "status": "machine"
    }
