  "translations": {
    "en": {
      "description": "You frighten the target by echoing its movements with ominous music and terrifying sound effects. It takes 1d4 psychic damage and becomes frightened of you until the spell ends.\n\nAt the end of each of the creature's turns, it can make another Wisdom saving throw, ending the effect on itself on a success. On a failed save, the creature takes 1d4 psychic damage.\n\nYou cannot cast another spell through your spellcasting focus while concentrating on this spell.",
      "name": "Dramatic Sting",
      "source_version": "snapshot",
      "status": "source"
    },
    "ru": {
      "description": "Вы пугаете цель, эхом повторяя её движения зловещей музыкой и ужасающими звуковыми эффектами. Она получает 1к4 психического урона и становится испуганной вами до конца заклинания.\n\nВ конце каждого хода существа оно может совершить ещё один спасбросок Мудрости, прекращая эффект на себе при успехе. При проваленном спасброске существо получает 1к4 психического урона.\n\nВы не можете творить другое заклинание через вашу заклинательную фокусировку, пока концентрируетесь на этом заклинании.",
      "glossary_version": "v1",
      "name": "Драматическое жало",
      "source_version": "snapshot",
      "status": "machine"
    }
  },
  "version": "snapshot"
