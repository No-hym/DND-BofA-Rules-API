  "translations": {
    "en": {
      "description": "You transform ambient ley power into a crackling bolt of energy 100 feet long and 5 feet wide. Each creature in the line takes 5d8 force damage, or half damage with a successful Dexterity saving throw. The bolt passes through the first inanimate object in its path, and creatures on the other side of the obstacle receive no bonus to their saving throw from cover. The bolt stops if it strikes a second object.",
      "name": "Ley Energy Bolt",
      "source_version": "snapshot",
      "status": "source"
    },
    "ru": {
      "description": "Вы превращаете окружающую лей-силу в потрескивающий болт энергии длиной 100 футов и шириной 5 футов. Каждое существо в линии получает 5к8 силового урона, или половину урона при успешном спасброске Ловкости. Болт проходит через первый неодушевлённый объект на своём пути, и существа на другой стороне препятствия не получают бонуса к их спасброску от укрытия. Болт останавливается, если он поражает второй объект.",
      "glossary_version": "v1",
      "name": "Болт лей-энергии",
      "source_version": "snapshot",
      "status": "machine"
    }
  },
