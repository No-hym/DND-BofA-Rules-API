    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "The shadow blight magically animates 1d4 plants within 60 feet of it, turning them into awakened shrubs under its control. These plants' attacks deal an additional 3 (1d6) necrotic damage. If the shrubs are not destroyed before 1 hour passes, they become new shadow blights.",
          "desc_ru": "Действие «Анимате Планц»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "ccdx_shadow-blight_animate-plants",
          "name": "Animate Plants",
          "name_ru": "Анимате Планц",
          "order_in_statblock": 1,
          "parent": "ccdx_shadow-blight",
          "ru_source": "derived",
          "uses_type": "RECHARGE_AFTER_REST"
        },
        {
          "action_type": "ACTION",
          "desc": "Melee Spell Attack: +5 to hit, reach 10 ft., one target. Hit: 7 (2d6) cold damage plus 3 (1d6) necrotic damage.",
          "desc_ru": "Атака заклинанием ближнего боя: +5 к попаданию, досягаемость 10 фт., одна цель. Попадание: 7 (2к6) холодного урона плюс 3 (1к6) некротического урона.",
          "external_id": "ccdx_shadow-blight_frozen-shadow-tendril",
          "name": "Frozen Shadow Tendril",
          "name_ru": "Фрозен теневой Тендрил",
          "order_in_statblock": 0,
          "parent": "ccdx_shadow-blight",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "While the shadow blight remains motionless, it is indistinguishable from the stump of a dead tree.",
          "desc_ru": "Особенность «Фалсе Аппеаранке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
