    "subentities": {
      "actions": [
        {
          "action_type": "ACTION",
          "desc": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 11 (2d6 + 4) slashing damage plus 9 (2d8) cold or fire damage.",
          "desc_ru": "Действие «Длинный меч»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_monolith-footman_longsword",
          "name": "Longsword",
          "name_ru": "Длинный меч",
          "order_in_statblock": 0,
          "parent": "tob_monolith-footman",
          "ru_source": "derived"
        },
        {
          "action_type": "ACTION",
          "desc": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 8 (1d8 + 4) bludgeoning damage plus 9 (2d8) cold or fire damage.",
          "desc_ru": "Действие «Удар»; тип: action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_monolith-footman_slam",
          "name": "Slam",
          "name_ru": "Удар",
          "order_in_statblock": 1,
          "parent": "tob_monolith-footman",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "While in the courts or castles of the fey, a monolith footman that scores a successful hit with its longsword can try to force the substitution of the target with a shadow double. The target must succeed at a DC 10 Charisma saving throw or become invisible, silent, and paralyzed, while an illusory version of itself remains visible and audible-and under the monolith footman's control, shouting for a retreat or the like. Outside fey locales, this ability does not function.",
          "desc_ru": "Особенность «Блатант Дисмиссал». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_monolith-footman_blatant-dismissal",
          "name": "Blatant Dismissal",
          "name_ru": "Блатант Дисмиссал",
          "parent": "tob_monolith-footman",
          "ru_source": "derived"
        },
        {
          "desc": "The ritual powering a monolith footman grants it an inner flame that it can use to enhance its weapon or its fists with additional fire or cold damage, depending on the construct's needs.",
          "desc_ru": "Особенность «Фея Фламе». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_monolith-footman_fey-flame",
          "name": "Fey Flame",
          "name_ru": "Фея Фламе",
          "parent": "tob_monolith-footman",
          "ru_source": "derived"
        },
        {
          "desc": "Monolith footmen are designed with a delicate fey construction. They burst into pieces and are destroyed when they receive a critical hit.",
          "desc_ru": "Особенность «Симпле Конструктион». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_monolith-footman_simple-construction",
          "name": "Simple Construction",
          "name_ru": "Симпле Конструктион",
          "parent": "tob_monolith-footman",
          "ru_source": "derived"
        }
      ]
