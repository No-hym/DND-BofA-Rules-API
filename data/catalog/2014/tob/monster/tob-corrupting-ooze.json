      "actions": [
        {
          "action_type": "ACTION",
          "desc": "Melee Weapon Attack: +6 to hit, reach 5 ft., one target. Hit: 12 (2d8 + 3) bludgeoning damage plus 3 (1d6) acid damage, and the target is grappled (escape DC 13).",
          "desc_ru": "Атака оружием ближнего боя: +6 к попаданию, досягаемость 5 фт., одна цель. Попадание: 12 (2к8+3) дробящего урона плюс 3 (1к6) кислотного урона, и цель схвачено (Сл освобождения 13).",
          "external_id": "tob_corrupting-ooze_slam",
          "name": "Slam",
          "name_ru": "Удар",
          "order_in_statblock": 0,
          "parent": "tob_corrupting-ooze",
          "ru_source": "template"
        }
      ],
      "traits": [
        {
          "desc": "When a corrupting ooze scores a critical hit or starts its turn with a foe grappled, it can dissolve one leather, metal, or wood item of its choosing in the possession of the target creature. A mundane item is destroyed automatically; a magical item is destroyed if its owner fails to make a successful DC 16 Dexterity saving throw.",
          "desc_ru": "Особенность «Корруптинг Тоуч». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_corrupting-ooze_corrupting-touch",
          "name": "Corrupting Touch",
          "name_ru": "Корруптинг Тоуч",
          "parent": "tob_corrupting-ooze",
          "ru_source": "derived"
        },
        {
          "desc": "A corrupting ooze naturally floats on the surface of water. It swims with a pulsating motion that propels it faster than walking speed.",
          "desc_ru": "Особенность «Стронг Свиммер». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob_corrupting-ooze_strong-swimmer",
          "name": "Strong Swimmer",
          "name_ru": "Стронг Свиммер",
          "parent": "tob_corrupting-ooze",
          "ru_source": "derived"
        }
      ]
