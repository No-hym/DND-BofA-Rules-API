    "subentities": {
      "actions": [
        {
          "action_type": "BONUS_ACTION",
          "desc": "Magically transforms into a Small or Med Humanoid or back into its true Fiendish form. Its stats other than size are the same in each form. No matter the form chemosit always has only one leg. Its crutch adjusts to fit its new form but no other equipment transforms. Reverts on death. Crutch becomes nonmagical.",
          "desc_ru": "Действие «Чанге Шапе»; тип: bonus_action. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_chemosit_change-shape",
          "name": "Change Shape",
          "name_ru": "Чанге Шапе",
          "order_in_statblock": 0,
          "parent": "tob3_chemosit",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "Its open mouth emits a red light shedding bright light in 10 ft. radius and dim light additional 10 feet. Opening or closing its mouth doesn’t require an action.",
          "desc_ru": "Особенность «Иннер Лигхт». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
