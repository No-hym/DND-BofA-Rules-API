    "subentities": {
      "traits": [
        {
          "desc": "Can pinpoint location of poisoned creatures or creatures suffering from a disease within 60' of her and can sense general direction of such creatures within 1 mile of her.",
          "desc_ru": "Особенность «Дисеасе Сенсе». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_hag-pesta_disease-sense",
          "name": "Disease Sense",
          "name_ru": "Дисеасе Сенсе",
          "parent": "tob3_hag-pesta",
          "ru_source": "derived"
        },
        {
          "desc": "At start of each of hag’s turns each creature within 10 ft. of her takes 4 (1d8) poison. If a creature remains within aura for more than 1 min it contracts disease of hag’s choice (DC 13 Con negates disease). Disease’s save DC is 13 regardless of type.",
          "desc_ru": "Особенность «Пестиленке Аура». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_hag-pesta_pestilence-aura",
          "name": "Pestilence Aura",
          "name_ru": "Пестиленке Аура",
          "parent": "tob3_hag-pesta",
          "ru_source": "derived"
        },
        {
          "desc": "The pesta hag is immune to diseases.",
          "desc_ru": "Особенность «Плагуе Карриер». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_hag-pesta_plague-carrier",
