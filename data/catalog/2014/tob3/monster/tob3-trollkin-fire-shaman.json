      "actions": [
        {
          "action_type": "REACTION",
          "desc": "When shaman takes damage each creature within 5 ft. of it: DC 13 Dex save or take 7 (2d6) fire. Shaman is then wreathed in flames and teleports up to 30' to unoccupied space it can see.",
          "desc_ru": "Действие «Фиерй Ескапе»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_trollkin-fire-shaman_fiery-escape",
          "name": "Fiery Escape",
          "name_ru": "Фиерй Ескапе",
          "order_in_statblock": 0,
          "parent": "tob3_trollkin-fire-shaman",
          "ru_source": "derived",
          "uses_param": 2,
          "uses_type": "PER_DAY"
        }
      ],
      "traits": [
        {
          "desc": "Gains 3 hp at the start of its turn. If the trollkin takes acid or fire this ability doesn’t function at the start of its next turn. It dies only if it starts its turn with 0 hp and doesn’t regenerate.",
          "desc_ru": "Особенность «Регенератион». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_trollkin-fire-shaman_regeneration",
          "name": "Regeneration",
          "name_ru": "Регенератион",
          "parent": "tob3_trollkin-fire-shaman",
          "ru_source": "derived"
        },
        {
          "desc": "Its skin is thick and tough granting it a +1 bonus to Armor Class (already factored into its AC).",
          "desc_ru": "Особенность «Тик Скин». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
