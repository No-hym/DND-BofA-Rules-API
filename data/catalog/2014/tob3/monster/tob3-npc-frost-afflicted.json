    "subentities": {
      "actions": [
        {
          "action_type": "REACTION",
          "desc": "When a creature hits the frost-afflicted with weapon attack ice bursts from the frost-afflicted. Each creature within 5 ft. of the frost-afflicted must make a DC 13 Con save taking 5 (2d4) cold on a failed save or half damage if made.",
          "desc_ru": "Действие «Фригид Фларе»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_npc-frost-afflicted_frigid-flare",
          "name": "Frigid Flare",
          "name_ru": "Фригид Фларе",
          "order_in_statblock": 0,
          "parent": "tob3_npc-frost-afflicted",
          "ru_source": "derived"
        }
      ],
      "traits": [
        {
          "desc": "A creature with resistance to cold doesn’t have resistance to the cold dealt by the frost-afflicted. A creature with immunity to cold is unaffected by this trait.",
          "desc_ru": "Особенность «Бурнинг холодный». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_npc-frost-afflicted_burning-cold",
          "name": "Burning Cold",
          "name_ru": "Бурнинг холодный",
          "parent": "tob3_npc-frost-afflicted",
          "ru_source": "derived"
        },
        {
          "desc": "The frost-afflicted is infused with minor elemental power and it requires only half the amount of food and drink that a typical humanoid of its size needs.",
          "desc_ru": "Особенность «Икй Натуре». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_npc-frost-afflicted_icy-nature",
