    "subentities": {
      "traits": [
        {
          "desc": "When it takes damage each creature within 5 ft. of it: DC 15 Dex save or take 3 (1d6) fire. The fire ignites flammable objects within 5 ft. of ibexian that aren’t being worn or carried.",
          "desc_ru": "Особенность «Фиерй крови». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_ibexian_fiery-blood",
          "name": "Fiery Blood",
          "name_ru": "Фиерй крови",
          "parent": "tob3_ibexian",
          "ru_source": "derived"
        },
        {
          "desc": "If it moves 20'+ straight toward a target and then hits it with Ram attack on the same turn target takes extra 7 (2d6) fire. If target is a creature it must make DC 15 Str save or be pushed up to 10 ft. away and knocked prone.",
          "desc_ru": "Особенность «Фиерй Чарге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_ibexian_fiery-charge",
          "name": "Fiery Charge",
          "name_ru": "Фиерй Чарге",
          "parent": "tob3_ibexian",
          "ru_source": "derived"
        },
        {
          "desc": "Advantage on attacks vs. creature if 1+ unincapacitated attacker ally is within 5 ft. of target.",
          "desc_ru": "Особенность «Пак Тактикс». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
