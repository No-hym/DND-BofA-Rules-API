      "actions": [
        {
          "action_type": "REACTION",
          "desc": "When a rakshasa the servitor can see within 15 ft. of it is the target of an attack the servitor can move up to half its speed toward that rakshasa with o provoking opportunity attacks. If it ends this movement within 5 ft. of the rakshasa the servitor becomes the target of the attack instead.",
          "desc_ru": "Действие «Протектинг Поунке»; тип: reaction. Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_rakshasa-servitor_protecting-pounce",
          "name": "Protecting Pounce",
          "name_ru": "Протектинг Поунке",
          "order_in_statblock": 0,
