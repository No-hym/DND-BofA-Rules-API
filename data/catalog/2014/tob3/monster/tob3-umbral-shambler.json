    "subentities": {
      "traits": [
        {
          "desc": "In sunlight disadvantage on attacks and Wis (Perception) checks that use sight.",
          "desc_ru": "Особенность «Сунлигхт Сенситивитй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_umbral-shambler_sunlight-sensitivity",
          "name": "Sunlight Sensitivity",
          "name_ru": "Сунлигхт Сенситивитй",
          "parent": "tob3_umbral-shambler",
          "ru_source": "derived"
        },
        {
          "desc": "Its speed is doubled in dim light or darkness and it doesn’t provoke opportunity attacks when it moves provided it moves only in dim light or darkness. In addition when a creature that relies on sight attacks the umbral shambler while the shambler is in dim light or darkness the attacker has disadvantage on the attack roll.",
          "desc_ru": "Особенность «Тенеброус Агилитй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_umbral-shambler_tenebrous-agility",
          "name": "Tenebrous Agility",
          "name_ru": "Тенеброус Агилитй",
          "parent": "tob3_umbral-shambler",
          "ru_source": "derived"
        },
        {
          "desc": "Doesn’t require air food drink sleep or ambient pressure.",
          "desc_ru": "Особенность «Воид Травелер». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_umbral-shambler_void-traveler",
          "name": "Void Traveler",
          "name_ru": "Воид Травелер",
          "parent": "tob3_umbral-shambler",
          "ru_source": "derived"
        }
      ]
