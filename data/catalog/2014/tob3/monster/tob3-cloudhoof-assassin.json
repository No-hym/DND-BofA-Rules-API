    "subentities": {
      "traits": [
        {
          "desc": "If it moves at least 20' straight toward a target and then hits it with Headbutt attack on the same turn that target must make DC 13 Str save or be pushed up to 10 ft. away from the cloudhoof. If a creature fails this save by 5 or more it is pushed up to 15 ft..",
          "desc_ru": "Особенность «Шовинг Чарге». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_cloudhoof-assassin_shoving-charge",
          "name": "Shoving Charge",
          "name_ru": "Шовинг Чарге",
          "parent": "tob3_cloudhoof-assassin",
          "ru_source": "derived"
        },
        {
          "desc": "Has advantage on Str and Dex checks and saves made vs. effects that would knock it prone. In addition it has advantage on Str (Athletics) checks to climb rocky surfaces and Dex (Acrobatics) checks to maintain its balance on rocky surfaces.",
          "desc_ru": "Особенность «Суре-хоовед». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_cloudhoof-assassin_sure-hooved",
          "name": "Sure-Hooved",
