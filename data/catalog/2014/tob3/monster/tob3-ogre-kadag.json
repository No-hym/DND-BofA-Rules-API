    "subentities": {
      "traits": [
        {
          "desc": "Any creature that isn’t Undead and that starts its turn within 5 ft. of the kadag ogre: poisoned until the start of its next turn (DC 15 Con negates and target immune to the kadag ogre’s Scent of Death for 1 hr).",
          "desc_ru": "Особенность «Скент смерти». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_ogre-kadag_scent-of-death",
          "name": "Scent of Death",
          "name_ru": "Скент смерти",
          "parent": "tob3_ogre-kadag",
          "ru_source": "derived"
        },
        {
          "desc": "An Undead has disadvantage on attack rolls vs. the kadag ogre if the ogre hasn’t attacked that Undead within the past 24 hrs. In addition each skeleton and zombie within 30' of the kadag ogre that has no master follows ogre’s verbal commands until a master asserts magical control over it.",
          "desc_ru": "Особенность «Нежить Аффинитй». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_ogre-kadag_undead-affinity",
          "name": "Undead Affinity",
          "name_ru": "Нежить Аффинитй",
          "parent": "tob3_ogre-kadag",
          "ru_source": "derived"
        }
      ]
