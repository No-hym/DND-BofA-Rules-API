    "subentities": {
      "traits": [
        {
          "desc": "While motionless indistinguishable from ordinary oak tree.",
          "desc_ru": "Особенность «Фалсе Аппеаранке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_oaken-sentinel_false-appearance",
          "name": "False Appearance",
          "name_ru": "Фалсе Аппеаранке",
          "parent": "tob3_oaken-sentinel",
          "ru_source": "derived"
        },
        {
          "desc": "Can have up to six Grasping Branches at a time. Each Grasping Branch can be attacked (AC 16; 25 hp; vulnerability to lightning; immunity to poison and psychic). Destroying a Grasping Branch deals no damage to the oaken sentinel which can extend a replacement branch on its next turn. A Grasping Branch can also be broken if a creature takes an action and succeeds on a DC 16 Str check vs. it.",
          "desc_ru": "Особенность «Граспинг Бранчес». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_oaken-sentinel_grasping-branches",
          "name": "Grasping Branches",
          "name_ru": "Граспинг Бранчес",
          "parent": "tob3_oaken-sentinel",
          "ru_source": "derived"
        }
      ]
