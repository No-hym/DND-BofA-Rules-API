    "subentities": {
      "traits": [
        {
          "desc": "Magic darkness doesn’t impede its darkvision.",
          "desc_ru": "Особенность «Дьявол С Сигхт». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_devil-maelstrom_devils-sight",
          "name": "Devil’s Sight",
          "name_ru": "Дьявол С Сигхт",
          "parent": "tob3_devil-maelstrom",
          "ru_source": "derived"
        },
        {
          "desc": "Nearby weather responds to devil’s desires. At start of each min devil can choose to change precipitation and wind within 1 mile of it by one stage up or down (no action required). This works like the changing weather conditions aspect of the control weather spell except devil can’t change temperature and conditions change immediately.",
          "desc_ru": "Особенность «Инфлуенке Веатер». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_devil-maelstrom_influence-weather",
          "name": "Influence Weather",
          "name_ru": "Инфлуенке Веатер",
          "parent": "tob3_devil-maelstrom",
          "ru_source": "derived"
        },
        {
          "desc": "Advantage: spell/magic effect saves.",
          "desc_ru": "Особенность «Магик Ресистанке». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
