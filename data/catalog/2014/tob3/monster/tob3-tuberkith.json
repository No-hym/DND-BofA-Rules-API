    "subentities": {
      "traits": [
        {
          "desc": "Has advantage on Str and Dex saves made vs. effects that would move it vs. its will along the ground.",
          "desc_ru": "Особенность «Дееп Рооц». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_tuberkith_deep-roots",
          "name": "Deep Roots",
          "name_ru": "Дееп Рооц",
          "parent": "tob3_tuberkith",
          "ru_source": "derived"
        },
        {
          "desc": "Has advantage on Wis (Perception) checks that rely on sight and on saves vs. being blinded. In addition if the tuberkith isn’t blinded creatures attacking it can’t benefit from traits and features that rely on a creature’s allies distracting or surrounding the tuberkith such as the Pack Tactics trait or Sneak Attack feature.",
          "desc_ru": "Особенность «Дозенс Еес». Производный машинный текст из структурированных полей записи; полный исходный текст — в поле desc (требуется перевод и редакторская вычитка).",
          "external_id": "tob3_tuberkith_dozens-of-eyes",
          "name": "Dozens of Eyes",
          "name_ru": "Дозенс Еес",
          "parent": "tob3_tuberkith",
          "ru_source": "derived"
        }
