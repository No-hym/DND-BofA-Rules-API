{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-bofa.example/schemas/entity.schema.json",
  "title": "DND-BofA Rules content entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "edition", "publisher_id", "book_id", "source", "license", "version", "external_id", "translations", "mechanics", "attribution"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "edition": {"enum": ["2014", "2024"]},
    "publisher_id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "external_id": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "translations": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "en": {"$ref": "#/$defs/translation"},
        "ru": {"$ref": "#/$defs/translation"}
      }
    },
    "mechanics": {"$ref": "#/$defs/mechanics"}
  },
  "$defs": {
    "mechanics": {
      "type": "object",
      "description": "Structured game mechanics. Category-specific fields are allowed; shared dependency/choice keys use the documented shapes.",
      "properties": {
        "requirements": {"type": "array", "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "target": {"type": "string"}, "operator": {"enum": ["eq", "gte", "lte", "in", "has"]}, "value": {}, "all": {"type": "array", "items": {"type": "object"}}, "any": {"type": "array", "items": {"type": "object"}}, "not": {"type": "object"}, "description": {"type": "string"}}, "additionalProperties": true}},
        "limitations": {"type": "array", "items": {"type": "object", "properties": {"type": {"type": "string"}, "target": {"type": "string"}, "value": {}, "when": {"type": "object"}}, "additionalProperties": true}},
        "choices": {"type": "array", "items": {"type": "object", "required": ["key", "options"], "properties": {"key": {"type": "string"}, "count": {"type": "integer", "minimum": 1}, "selection_type": {"type": "string"}, "options": {"type": "array", "items": {}}, "requirements": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true}},
        "relations": {"type": "array", "items": {"type": "object", "required": ["target_id", "type"], "properties": {"target_id": {"type": "string"}, "type": {"type": "string"}, "required": {"type": "boolean"}, "requirements": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true}},
        "compatibility": {"type": "object", "properties": {"editions": {"type": "array", "items": {"enum": ["2014", "2024"]}}, "sources": {"type": "array", "items": {"type": "string"}}, "homebrew_compatible": {"type": "boolean"}}, "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "translation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "status": {"enum": ["source", "machine", "reviewed", "outdated"]},
        "updated_at": {"type": "string", "format": "date"},
        "source_version": {"type": "string"},
        "glossary_version": {"type": "string"}
      }
    }
  }
}
